{
  "name": "unofficial-vwo-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial MCP server exposing VWO platform operations as agent-callable tools.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "unofficial-vwo-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "node dist/index.js --verify",
    "register:claude": "node scripts/register_mcp_server_claude.js",
    "register:codex": "node scripts/register_mcp_server_codex.js",
    "register:vscode": "node scripts/register_mcp_server_vscode.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
