# Copy to .env for LOCAL DEVELOPMENT ONLY (.env is gitignored).
#
# In production, do NOT use a .env file. Pass these to the server process from
# your agent wrapper's MCP server config, or use VWO_API_TOKEN_FILE.
# See README.md -> "Configuring the API token".

# Required — generate at https://app.vwo.com/#/developers/tokens
VWO_API_TOKEN=

# Preferred alternative to VWO_API_TOKEN: absolute path to a file whose entire
# contents are the token. Avoids exposing the secret in the process environment
# (readable via `ps -e` / /proc on some systems). Takes precedence if both are set.
# VWO_API_TOKEN_FILE=/run/secrets/vwo_api_token

# Optional — pin a default account. Accepts a numeric id, or `current` to let
# VWO resolve it from the token. When UNSET, account-scoped tools require an
# explicit accountId argument instead of guessing — the right default when one
# token manages several client accounts.
# VWO_ACCOUNT_ID=

# Optional guardrail — comma-separated allow-list of account ids this server may
# touch. Anything else is refused, and vwo_list_accounts hides non-listed
# accounts. Strongly recommended when the token can reach clients this agent
# has no business touching.
# VWO_ALLOWED_ACCOUNT_IDS=123456,789012

# Optional overrides — defaults match VWO's documented API.
# Set to https://app.vwo.com/api/v2 if your account is on the older host.
# VWO_API_BASE_URL=https://app.wingify.com/api/v2
#
# Header carrying the token. VWO documents `token: <your-token>`.
# VWO_AUTH_HEADER=token

# Optional — VWO rate-limits 1 request/second per token. Raise if you hit 429s.
# VWO_MIN_REQUEST_INTERVAL_MS=1000
# VWO_REQUEST_TIMEOUT_MS=30000
